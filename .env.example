# ===========================================
# Revryze Sales Training — Environment Variables
# Copy to `.env` (local) or set as Replit Secrets (prod).
# ===========================================

# --- Database (Postgres) ---
# Replit: use the built-in Postgres (Tools → Database) and paste its connection URL here.
# Neon fallback: create a project at neon.tech, then paste the pooled connection string.
DATABASE_URL="postgresql://user:pass@host:5432/revryze?schema=public"

# --- NextAuth ---
# Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
# Public URL of the app. For Replit, this is your *.replit.app URL.
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Google Cloud Console → APIs & Services → Credentials) ---
# Create an OAuth 2.0 Client ID (Web application).
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=""
# Optional: override the default Claude model. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Access Control ---
# Comma-separated list of emails auto-promoted to ADMIN on first sign-in.
SUPER_ADMIN_EMAILS="founder@revryze.com,ops@revryze.com"
# The only email domain allowed to sign in. Defaults to revryze.com.
ALLOWED_EMAIL_DOMAIN="revryze.com"
